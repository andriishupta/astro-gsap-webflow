---
import "./MobileCoordinateExperience.css";
---

<main
  class="mobile-coordinate"
  data-mobile-coordinate
  aria-label="Cathedral of Threads mobile story"
>
  <button
    class="mobile-coordinate__about"
    type="button"
    data-mobile-dialog-open
  >
    About
  </button>

  <picture class="mobile-coordinate__backdrop" aria-hidden="true">
    <source
      srcset="/images/coordinate/mobile-light.webp"
      media="(prefers-color-scheme: light)"
      type="image/webp"
    />
    <img
      src="/images/coordinate/mobile-dark.webp"
      width="1200"
      height="2160"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="mobile-coordinate__backdrop-shade" aria-hidden="true"></div>

  <section
    class="mobile-coordinate__panel mobile-coordinate__panel--opening"
    id="mobile-start"
  >
    <p class="mobile-coordinate__index" aria-hidden="true">01 / 03</p>
    <div class="mobile-coordinate__copy mobile-coordinate__copy--opening">
      <p class="mobile-coordinate__eyebrow">A mobile passage</p>
      <h1>
        <span>Cathedral</span>
        <span>of Threads</span>
      </h1>
      <p class="mobile-coordinate__premise">
        The coordinate where every memory converges.
      </p>
      <p class="mobile-coordinate__desktop-hint">
        Use desktop for the full experience.
      </p>
    </div>
    <a class="mobile-coordinate__cue" href="#mobile-approach">
      <span>Swipe to enter</span>
      <span aria-hidden="true"></span>
    </a>
  </section>

  <section
    class="mobile-coordinate__panel mobile-coordinate__panel--approach"
    id="mobile-approach"
  >
    <p class="mobile-coordinate__index" aria-hidden="true">02 / 03</p>
    <div class="mobile-coordinate__copy">
      <p class="mobile-coordinate__eyebrow">Convergence</p>
      <h2>Every path remembers.</h2>
      <p>A thousand lives. One shared echo.</p>
    </div>
  </section>

  <section
    class="mobile-coordinate__panel mobile-coordinate__panel--afterglow"
    id="mobile-afterglow"
  >
    <p class="mobile-coordinate__index" aria-hidden="true">03 / 03</p>
    <div class="mobile-coordinate__copy mobile-coordinate__copy--afterglow">
      <p class="mobile-coordinate__eyebrow">Afterglow</p>
      <h2>Nothing is ever truly lost.</h2>
      <p>The way forward remembers the way back.</p>
      <button type="button" data-mobile-rewind>Tap to rewind</button>
    </div>

    <footer class="mobile-coordinate__footer">
      <span>Made by</span>
      <a href="https://andriishupta.dev" target="_blank" rel="noreferrer"
        >Andrii Shupta</a
      >
      <a
        href="https://github.com/andriishupta/astro-gsap-webflow"
        target="_blank"
        rel="noreferrer">GitHub</a
      >
    </footer>
  </section>

  <dialog
    class="mobile-coordinate__dialog"
    data-mobile-dialog
    aria-labelledby="mobile-about-title"
    aria-describedby="mobile-about-description"
  >
    <button
      class="mobile-coordinate__dialog-close"
      type="button"
      data-mobile-dialog-close
      aria-label="Close About"
    >
      <span aria-hidden="true">×</span>
    </button>
    <div class="mobile-coordinate__dialog-scroll" data-mobile-dialog-scroll>
      <p class="mobile-coordinate__eyebrow">About the experiment</p>
      <h2 id="mobile-about-title">A place outside time.</h2>
      <div id="mobile-about-description">
        <p>
          Cathedral of Threads is a hackathon-built experiment about collective
          memory. The desktop version renders its dunes and luminous paths in
          real time; this mobile passage uses one lightweight scene still
          selected for your device theme.
        </p>
        <p>
          The initial spark came from the idea of the Coordinate in
          <cite>Attack on Titan</cite>. This independent interpretation
          reproduces no characters, production artwork, dialogue, music, or
          story material.
        </p>
        <p>
          The project is not affiliated with, endorsed by, or connected to the
          anime, manga, studios, publishers, or rights holders.
        </p>
      </div>
      <p class="mobile-coordinate__dialog-meta">
        Made by
        <a href="https://andriishupta.dev" target="_blank" rel="noreferrer"
          >Andrii Shupta</a
        >. Built with Astro, Three.js, and GSAP.
        <a
          href="https://github.com/andriishupta/astro-gsap-webflow"
          target="_blank"
          rel="noreferrer">Source on GitHub</a
        >.
      </p>
    </div>
  </dialog>
</main>

<script>
  import "./MobileCoordinateExperience.client";
</script>
